<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://kit.fontawesome.com/50bf1045f2.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="style/style.css">
    <title>PDF AI analyzer</title>
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <a href="#home"> <img src="images/RemoveBackground.png" alt="PDF AI Logo"> </a>
            </div>
        </nav>
    </header>

    <main>
        <section id="home" class="hero">
            <h1>Extract, Summarize and Analyze your PDF file with <span class="blurred">AI</span></h1>
            <p>100% free for a max of 4MB pdf files</p>
            <a href="#feat" class="cta-btn">Get Started</a>
        </section>

        <section class="features" id="feat">
            <div class="feature-grid">
              
                <div class="feature-btn">  
                    <form action="/upload" method="POST" class="pdf-action-upload">
                        <label for="file_inputID" class="cta-btn-upload" id="cta-btn-upload-id">
                            <i class="fas fa-cloud-upload-alt" style="margin-right: 8px;"></i>
                            Upload PDF file
                        </label>
                    </form>        

                    <form action="/analyze" method="POST" class="pdf-action-form" enctype="multipart/form-data">
                        <input type="file" id="file_inputID" name="file_inputName" style="display: none;" accept="application/pdf">
                        <input class="titleTextBox" placeholder="Enter your prompt here..." name="postPrompt">
                        <button type="submit" class="cta-btn-analyze" id="cta-btn-submit">
                            <i class="fas fa-paper-plane" style="margin-right: 8px;"></i>
                            Analyze
                        </button> 
                    </form>
                </div>
            
                <div class="feature-card feature-bkless">
                    <p id="pdf-name"></p>
                    <iframe class="pdf-content" id="pdf-content-id" enctype="multipart/form-data"></iframe>
                </div>
               
            </div>
        </section>  

        <section class="features-output feature-card-output" id="output">
             <% if (!result) { %>
                <p class="blog-content">Your output will appear here after analysis...</p>
             <% } else { %>
                <p class="blog-content"><%= result %></p>
             <% } %>
        </section>

    </main>
    <script src="/js/script.js"></script>
</body>
</html>
